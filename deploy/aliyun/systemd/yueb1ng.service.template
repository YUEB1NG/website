[Unit]
Description=YUEB1NG website
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=admin
WorkingDirectory=@RELEASE@
Environment=YUEB1NG_DATA_DIR=@DATA@
ExecStart=@NODE@ @RELEASE@/deploy/aliyun/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
